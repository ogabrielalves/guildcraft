{
  "name": "guildcraft",
  "version": "1.0.0",
  "description": "A pixel-art guild workshop where every adventurer is a live Claude Code agent",
  "keywords": [
    "claude-code",
    "agents",
    "pixel-art",
    "terminal",
    "mcp"
  ],
  "homepage": "https://github.com/ogabrielalves/guildcraft#readme",
  "bugs": "https://github.com/ogabrielalves/guildcraft/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogabrielalves/guildcraft.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Gabriel Alves",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "guildcraft": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "assets"
  ],
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "dev": "tsup && concurrently -k -n server,web \"tsx watch src/bin/cli.ts --no-open\" \"vite\"",
    "build": "tsup && vite build",
    "prepack": "npm run build",
    "start": "node dist/bin/cli.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.3.0",
    "open": "^10.2.0",
    "tree-kill": "^1.2.2",
    "ws": "^8.22.0",
    "zod": "4.6.7"
  }
}
