{
  "name": "guildcraft",
  "version": "0.0.0",
  "description": "A pixel-art guild workshop where every adventurer is a live Claude Code agent",
  "keywords": [
    "claude-code",
    "agents",
    "pixel-art",
    "terminal",
    "mcp"
  ],
  "homepage": "https://github.com/ogabrielalves/guildcraft#readme",
  "bugs": "https://github.com/ogabrielalves/guildcraft/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogabrielalves/guildcraft.git"
  },
  "license": "MIT",
  "author": "Gabriel Alves",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "assets"
  ],
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "dev": "concurrently -k -n server,web \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build && tsup",
    "start": "node dist/bin/cli.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "open": "^10.2.0",
    "tree-kill": "^1.2.2"
  }
}
